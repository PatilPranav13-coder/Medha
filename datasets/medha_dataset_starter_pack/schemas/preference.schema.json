{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medha Preference Record",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "prompt_messages",
    "chosen",
    "rejected",
    "scores",
    "preference_reason",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt_messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "chosen": {
      "type": "string",
      "minLength": 1
    },
    "rejected": {
      "type": "string",
      "minLength": 1
    },
    "scores": {
      "type": "object",
      "required": [
        "chosen",
        "rejected"
      ],
      "properties": {
        "chosen": {
          "type": "object",
          "required": [
            "helpfulness",
            "correctness",
            "coherence",
            "complexity",
            "verbosity"
          ],
          "properties": {
            "helpfulness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "correctness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "coherence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "complexity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "verbosity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "additionalProperties": false
        },
        "rejected": {
          "type": "object",
          "required": [
            "helpfulness",
            "correctness",
            "coherence",
            "complexity",
            "verbosity"
          ],
          "properties": {
            "helpfulness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "correctness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "coherence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "complexity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "verbosity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "preference_reason": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "domain_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_metadata": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_dataset",
        "source_revision",
        "source_split",
        "source_record_id",
        "declared_license",
        "underlying_license",
        "content_sha256",
        "pipeline_version",
        "usage_status"
      ],
      "properties": {
        "source_dataset": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_config": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_split": {
          "type": "string",
          "minLength": 1
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "declared_license": {
          "type": "string"
        },
        "underlying_license": {
          "type": "string"
        },
        "usage_status": {
          "enum": [
            "approved",
            "approved_with_attribution",
            "conditional",
            "hold",
            "excluded",
            "unknown"
          ]
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duplicate_cluster_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "transformation_version": {
          "type": "string"
        },
        "pipeline_version": {
          "type": "string"
        },
        "acquired_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source_metadata": {
          "type": "object"
        },
        "attribution_text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
