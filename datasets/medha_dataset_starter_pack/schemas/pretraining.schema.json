{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medha Pretraining Record",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "text",
    "content_type",
    "domain_tags",
    "language",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "enum": [
        "text",
        "code",
        "math",
        "mixed"
      ]
    },
    "domain_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "language": {
      "type": "string"
    },
    "quality_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "source_metadata": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_dataset",
        "source_revision",
        "source_split",
        "source_record_id",
        "declared_license",
        "underlying_license",
        "content_sha256",
        "pipeline_version",
        "usage_status"
      ],
      "properties": {
        "source_dataset": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_config": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_split": {
          "type": "string",
          "minLength": 1
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "declared_license": {
          "type": "string"
        },
        "underlying_license": {
          "type": "string"
        },
        "usage_status": {
          "enum": [
            "approved",
            "approved_with_attribution",
            "conditional",
            "hold",
            "excluded",
            "unknown"
          ]
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duplicate_cluster_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "transformation_version": {
          "type": "string"
        },
        "pipeline_version": {
          "type": "string"
        },
        "acquired_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source_metadata": {
          "type": "object"
        },
        "attribution_text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
