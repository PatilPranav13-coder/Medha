# Copy to .env and replace both placeholders before running Medha.
# Use URL-safe characters in POSTGRES_PASSWORD so the database URL stays valid.
MEDHA_ENV=development
MEDHA_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
MEDHA_COOKIE_SECURE=false
MEDHA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_DB=medha
POSTGRES_USER=medha
POSTGRES_PASSWORD=replace-with-a-unique-database-password
MEDHA_DATABASE_URL=postgresql+psycopg2://medha:replace-with-a-unique-database-password@db:5432/medha

MEDHA_AI_PROVIDER=ollama
MEDHA_AI_BASE_URL=http://ollama:11434
MEDHA_MODEL_NAME=qwen2.5-coder:7b
MEDHA_MODELS=qwen2.5-coder:7b
MEDHA_AI_API_KEY=
MEDHA_EMBEDDING_MODEL=nomic-embed-text
MEDHA_EMBEDDING_DIMENSION=768
MEDHA_MAX_UPLOAD_BYTES=10485760

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
