# Copy to .env and set real values locally. Do not commit .env.
MEDHA_DOMAIN=medha.example.com

# Select an installed model explicitly. Empty model is rejected at app startup.
MEDHA_BRAIN_PROVIDER=openai_compat
MEDHA_BRAIN_BASE_URL=http://ollama:11434/v1
MEDHA_BRAIN_MODEL=
MEDHA_BRAIN_API_KEY=

MEDHA_DATABASE_PATH=/data/medha.sqlite3
MEDHA_UPLOAD_DIR=/data/uploads
MEDHA_MAX_UPLOAD_BYTES=5242880
MEDHA_USER_UPLOAD_QUOTA_BYTES=26214400
MEDHA_BOOTSTRAP_INVITE_CODE=
MEDHA_MAX_USERS=100
MEDHA_MAX_CONCURRENT_GENERATIONS=1
MEDHA_MAX_QUEUED_GENERATIONS=4
MEDHA_MAINTENANCE=false
MEDHA_SIGNUPS_ENABLED=true
MEDHA_READ_ONLY=false
MEDHA_LOG_RETENTION_DAYS=30
MEDHA_COOKIE_SECURE=true
MEDHA_CONSENT_NOTICE_VERSION=2026-11-27-v1
GRIEVANCE_EMAIL=

MEDHA_SEARCH_PROVIDER=auto
BRAVE_API_KEY=
MEDHA_SEARXNG_URL=

# Optional error reporting; sent events are scrubbed of request bodies and credentials.
SENTRY_DSN=

# Optional local-brain container image override.
OLLAMA_IMAGE=ollama/ollama:0.40.18
